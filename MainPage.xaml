<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GamerSurvey.MainPage"
             Title="Анкета геймера"
             BackgroundColor="#1a1a2e">

    <!-- ScrollView — все поля доступны на небольшом экране -->
    <ScrollView Padding="20">

        <VerticalStackLayout Spacing="16">

            <!-- ===== ЗАГОЛОВОК ===== -->
            <!-- Label #1: заголовок анкеты -->
            <Label x:Name="lblTitle"
                   Text="🎮 Анкета геймера"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#e94560"
                   HorizontalTextAlignment="Center" />

            <!-- Label #2: описание -->
            <Label x:Name="lblDescription"
                   Text="Расскажи о своих игровых предпочтениях!"
                   FontSize="16"
                   FontAttributes="Italic"
                   TextColor="#a0a0b8"
                   HorizontalTextAlignment="Center" />

            <!-- Image #1: аватарка/баннер -->
            <Image x:Name="imgBanner"
                   Source="gamepad.png"
                   Aspect="AspectFit"
                   HeightRequest="120"
                   Margin="0,8"
                   HorizontalOptions="Center" />

            <!-- ===== СЕКЦИЯ: ЛИЧНЫЕ ДАННЫЕ (Grid) ===== -->
            <Border Margin="0,4" BackgroundColor="#16213e" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16">
                <Grid RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="120,*"
                      RowSpacing="12"
                      ColumnSpacing="10">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Никнейм:"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#e94560"
                           VerticalTextAlignment="Center" />

                    <!-- Entry #1: никнейм (Keyboard=Text) -->
                    <Entry x:Name="entryNickname"
                           Grid.Row="0" Grid.Column="1"
                           Margin="4,0"
                           Placeholder="Введите ваш никнейм"
                           Keyboard="Text"
                           MaxLength="30"
                           TextColor="White"
                           PlaceholderColor="#555577"
                           BackgroundColor="#0f3460" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Email:"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#e94560"
                           VerticalTextAlignment="Center" />

                    <!-- Entry #2: email (Keyboard=Email) -->
                    <Entry x:Name="entryEmail"
                           Grid.Row="1" Grid.Column="1"
                           Margin="4,0"
                           Placeholder="your@email.com"
                           Keyboard="Email"
                           MaxLength="50"
                           TextColor="White"
                           PlaceholderColor="#555577"
                           BackgroundColor="#0f3460" />

                    <Label Grid.Row="2" Grid.Column="0"
                           Text="Дата рождения:"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#e94560"
                           VerticalTextAlignment="Center" />

                    <!-- DatePicker #1 -->
                    <DatePicker x:Name="dpBirthDate"
                                Grid.Row="2" Grid.Column="1"
                                Margin="4,0"
                                Format="dd.MM.yyyy"
                                Date="2000-01-15"
                                MinimumDate="1950-01-01"
                                MaximumDate="2015-12-31"
                                TextColor="White"
                                BackgroundColor="#0f3460" />
                </Grid>
            </Border>

            <!-- ===== СЕКЦИЯ: ПЛАТФОРМА (RadioButton) ===== -->
            <Border Margin="0,4" BackgroundColor="#16213e" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Основная платформа:"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#e94560" />

                    <!-- RadioButton #1 -->
                    <RadioButton x:Name="rbPC"
                                 Content="🖥 PC"
                                 GroupName="Platform"
                                 Value="PC"
                                 TextColor="#a0a0b8" />

                    <!-- RadioButton #2 -->
                    <RadioButton x:Name="rbConsole"
                                 Content="🎮 Консоль (PlayStation / Xbox)"
                                 GroupName="Platform"
                                 Value="Console"
                                 TextColor="#a0a0b8" />

                    <!-- RadioButton #3 -->
                    <RadioButton x:Name="rbMobile"
                                 Content="📱 Мобильное устройство"
                                 GroupName="Platform"
                                 Value="Mobile"
                                 TextColor="#a0a0b8" />
                </VerticalStackLayout>
            </Border>

            <!-- ===== СЕКЦИЯ: ЖАНР (Picker) ===== -->
            <Border Margin="0,4" BackgroundColor="#16213e" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Любимый жанр:"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#e94560" />

                    <!-- Picker #1: минимум 3 варианта -->
                    <Picker x:Name="pickerGenre"
                            Margin="0,4"
                            Title="Выберите жанр"
                            TextColor="White"
                            TitleColor="#555577"
                            BackgroundColor="#0f3460">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>RPG</x:String>
                                <x:String>Шутер (FPS/TPS)</x:String>
                                <x:String>Стратегия</x:String>
                                <x:String>Спортивные</x:String>
                                <x:String>Хоррор</x:String>
                                <x:String>Песочница</x:String>
                                <x:String>Гонки</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <!-- ===== СЕКЦИЯ: ЧАСЫ ИГРЫ В ДЕНЬ (Slider) ===== -->
            <Border Margin="0,4" BackgroundColor="#16213e" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Часов в день за играми:"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#e94560" />

                    <!-- Привязка через x:Reference: Label показывает текущее значение Slider -->
                    <Label x:Name="lblHoursValue"
                           FontSize="14"
                           FontAttributes="None"
                           TextColor="#a0a0b8"
                           Text="{Binding Path=Value, Source={x:Reference sliderHours}, StringFormat='{0:F1} ч.', Mode=OneWay}" />

                    <!-- Slider #1 -->
                    <Slider x:Name="sliderHours"
                            Margin="0,4"
                            Minimum="0"
                            Maximum="16"
                            Value="3"
                            MinimumTrackColor="#e94560"
                            MaximumTrackColor="#0f3460"
                            ThumbColor="#e94560" />
                </VerticalStackLayout>
            </Border>

            <!-- ===== СЕКЦИЯ: НАСТРОЙКИ (CheckBox + Switch) ===== -->
            <Border Margin="0,4" BackgroundColor="#16213e" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Дополнительно:"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#e94560" />

                    <!-- CheckBox #1 -->
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox x:Name="cbMultiplayer"
                                  IsChecked="false"
                                  Color="#e94560" />
                        <Label Text="Играю в мультиплеер"
                               TextColor="#a0a0b8"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>

                    <!-- CheckBox #2 -->
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox x:Name="cbStreaming"
                                  IsChecked="false"
                                  Color="#e94560" />
                        <Label Text="Стримлю на Twitch / YouTube"
                               TextColor="#a0a0b8"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>

                    <!-- Switch #1 -->
                    <HorizontalStackLayout Spacing="8">
                        <Switch x:Name="switchNotifications"
                                IsToggled="true"
                                OnColor="#e94560" />
                        <Label Text="Получать уведомления о новинках"
                               TextColor="#a0a0b8"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ===== СЕКЦИЯ: КОММЕНТАРИЙ (Editor) ===== -->
            <Border Margin="0,4" BackgroundColor="#16213e" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="О чём мечтаешь в игровом мире?"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#e94560" />

                    <!-- Editor #1 -->
                    <Editor x:Name="editorComment"
                            Margin="0,4"
                            Placeholder="Напишите ваши мысли, пожелания, любимые игры..."
                            AutoSize="TextChanges"
                            MaxLength="500"
                            TextColor="White"
                            PlaceholderColor="#555577"
                            BackgroundColor="#0f3460"
                            HeightRequest="100" />
                </VerticalStackLayout>
            </Border>

            <!-- ===== КНОПКИ ===== -->
            <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                <!-- Button #1: Показать результат -->
                <Button x:Name="btnResult"
                        Margin="4,0"
                        Text="🏆 Показать результат"
                        Clicked="OnShowResultClicked"
                        BackgroundColor="#e94560"
                        TextColor="White"
                        CornerRadius="8"
                        FontSize="15"
                        Padding="16,10" />

                <!-- Button #2: Очистить -->
                <Button x:Name="btnClear"
                        Margin="4,0"
                        Text="🗑 Очистить"
                        Clicked="OnClearClicked"
                        BackgroundColor="#533483"
                        TextColor="White"
                        CornerRadius="8"
                        FontSize="15"
                        Padding="16,10" />
            </HorizontalStackLayout>

            <!-- ===== РЕЗУЛЬТАТ ===== -->
            <Border x:Name="frameResult"
                    Margin="0,8"
                    BackgroundColor="#0f3460"
                    StrokeShape="RoundRectangle 12"
                    Stroke="#e94560"
                    StrokeThickness="1"
                    Padding="16"
                    IsVisible="false">

                <VerticalStackLayout Spacing="6">
                    <Label Text="📋 Результаты анкеты:"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#e94560" />

                    <Label x:Name="lblResult"
                           Text=""
                           FontSize="14"
                           FontAttributes="None"
                           TextColor="#d0d0e8"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Отступ снизу для удобной прокрутки -->
            <BoxView HeightRequest="40" Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
